<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. KML File Selection -->
        <Button
            android:id="@+id/btnSelectKml"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_select_kml"
            android:contentDescription="@string/select_kml_file_desc"
            android:minHeight="48dp" />

        <!-- KML status -->
        <TextView
            android:id="@+id/textViewKmlStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/kml_not_loaded"
            android:textColor="#F60000"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:contentDescription="@string/kml_status_desc" />

        <!-- 2. Mission Name (with info icon) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/editTextMissionName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_mission_name"
                android:inputType="textNoSuggestions"
                android:maxLength="32"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-"
                android:importantForAutofill="yes"
                android:autofillHints="username"
                android:contentDescription="@string/mission_name_desc"
                android:minHeight="48dp" />

            <ImageView
                android:id="@+id/iconMissionNameHelp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/mission_name_desc"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_info_24" />
        </LinearLayout>

        <!-- 3. Destination selection -->
        <Button
            android:id="@+id/btnSelectDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_select_destination"
            android:contentDescription="@string/select_destination_desc"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/textViewDestinationPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_no_destination"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:importantForAccessibility="yes" />

        <!-- 4. Flight Pattern (Strategy Selection) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_mission_type"
            android:layout_marginTop="8dp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupMissionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioPatternGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_pattern_grid" />

            <RadioButton
                android:id="@+id/radioPatternPerimeter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_pattern_perimeter" />
        </RadioGroup>

        <!-- 4b. Perimeter Corridor Width Options (Visible when Perimeter Mode is selected) -->
        <LinearLayout
            android:id="@+id/layoutPerimeterSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#10000000"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_perimeter_buffer_options"
                android:textStyle="bold"
                android:textSize="14sp" />

            <!-- Interior Radius -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_interior_offset"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editTextInteriorOffset"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="@string/hint_interior_offset"
                    android:gravity="center"
                    android:minHeight="48dp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarInteriorOffset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="500"
                android:progress="100"
                android:contentDescription="@string/desc_slider_interior"
                android:layout_marginBottom="8dp" />

            <!-- Exterior Radius -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_exterior_offset"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editTextExteriorOffset"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="@string/hint_exterior_offset"
                    android:gravity="center"
                    android:minHeight="48dp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarExteriorOffset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="500"
                android:progress="50"
                android:contentDescription="@string/desc_slider_exterior" />

            <!-- Slope-Corrected Ground Distance Options -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slope Correction Mode"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="12dp" />

            <RadioGroup
                android:id="@+id/radioGroupSlopeMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/radioSlopeOff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Off (Flat 2D Planar Distance)"
                    android:checked="true"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/radioSlopeAutoDem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto DEM Slope (Open-Source Tangent Gradient)"
                    android:textSize="12sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/textViewSlopeNetworkTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#D81B60"
                android:textStyle="italic"
                android:layout_marginTop="2dp"
                android:text="ℹ Auto DEM requires an active network connection for elevation lookup." />

            <TextView
                android:id="@+id/textViewSlopeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#388E3C"
                android:layout_marginTop="4dp"
                android:text="Off: Target ground distance matches 2D map offset." />

            <ProgressBar
                android:id="@+id/progressBarSlope"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 5. Altitude Presets & Custom Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_altitude"
            android:layout_marginTop="8dp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupAltitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioAlt200"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_altitude_200" />

            <RadioButton
                android:id="@+id/radioAlt400"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_altitude_400" />

            <RadioButton
                android:id="@+id/radioAltCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_altitude_custom" />
        </RadioGroup>

        <!-- Custom Altitude EditText (Visible when Custom is chosen) -->
        <EditText
            android:id="@+id/editTextCustomAltitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_custom_altitude"
            android:inputType="numberDecimal"
            android:visibility="gone"
            android:minHeight="48dp" />

        <!-- 6. Camera Type Options -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_camera"
            android:layout_marginTop="8dp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioCameraEO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_camera_eo" />

            <RadioButton
                android:id="@+id/radioCameraIR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_camera_ir" />

            <RadioButton
                android:id="@+id/radioCameraBoth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_camera_both" />
        </RadioGroup>

        <!-- 7. Generate Button -->
        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_generate_wpml"
            android:contentDescription="@string/generate_wpml_desc"
            android:enabled="false"
            android:layout_marginTop="16dp"
            android:minHeight="48dp" />

        <!-- Missing Criteria Warning Text (shown while btnGenerate is greyed out) -->
        <TextView
            android:id="@+id/textViewMissingRequirements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="⚠️ Required: Select KML • Name output • Select destination" />

        <!-- Optimization / Plan Summary Card -->
        <TextView
            android:id="@+id/textViewMetricsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="#15000000"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:textSize="13sp" />

        <!-- 8. Version Footer at bottom -->
        <TextView
            android:id="@+id/textViewNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="v2.0.2 • Generates optimal DJI WPML flight packages for DJI Pilot 2"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>